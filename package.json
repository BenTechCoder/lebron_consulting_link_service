{
  "name": "lebron_consulting_linker",
  "version": "0.0.0",
  "scripts": {
    "build": "ts-node ./scripts/build.ts && ng build",
    "clean-install": "rm -rf ./node_modules && rm -r package-lock.json && npm i",
    "dev": "NODE_ENV=development ts-node ./src/server/index.ts",
    "dev:hot": "nodemon --exec \"npm run dev\" --watch ./src/server --ext .ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "NODE_ENV=production node -r ./config.js ./dist",
    "test": "NODE_ENV=test vitest",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
